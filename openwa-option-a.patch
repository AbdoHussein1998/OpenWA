diff --git a/dashboard/src/utils/authStorage.test.ts b/dashboard/src/utils/authStorage.test.ts
new file mode 100644
--- /dev/null
+++ b/dashboard/src/utils/authStorage.test.ts
@@ -0,0 +1,58 @@
+import { beforeEach, test } from 'node:test';
+import assert from 'node:assert/strict';
+import { clearStoredApiKey, getStoredApiKey, saveApiKey } from './authStorage.ts';
+
+function createStorage(): Storage {
+  const values = new Map<string, string>();
+  return {
+    get length() { return values.size; },
+    clear() { values.clear(); },
+    getItem(key: string) { return values.get(key) ?? null; },
+    key(index: number) { return Array.from(values.keys())[index] ?? null; },
+    removeItem(key: string) { values.delete(key); },
+    setItem(key: string, value: string) { values.set(key, value); },
+  };
+}
+
+beforeEach(() => {
+  Object.assign(globalThis, {
+    sessionStorage: createStorage(),
+    localStorage: createStorage(),
+  });
+});
+
+test('Remember me persists only in localStorage', () => {
+  saveApiKey('remembered', true);
+  assert.equal(localStorage.getItem('openwa_api_key'), 'remembered');
+  assert.equal(sessionStorage.getItem('openwa_api_key'), null);
+  assert.equal(getStoredApiKey(), 'remembered');
+});
+
+test('unselected Remember me keeps the key in sessionStorage', () => {
+  saveApiKey('tab-only', false);
+  assert.equal(sessionStorage.getItem('openwa_api_key'), 'tab-only');
+  assert.equal(localStorage.getItem('openwa_api_key'), null);
+  assert.equal(getStoredApiKey(), 'tab-only');
+});
+
+test('switching to tab-only login removes an older remembered key', () => {
+  saveApiKey('old', true);
+  saveApiKey('new', false);
+  assert.equal(getStoredApiKey(), 'new');
+  assert.equal(localStorage.getItem('openwa_api_key'), null);
+});
+
+test('the tab-specific key takes priority when both storages contain keys', () => {
+  sessionStorage.setItem('openwa_api_key', 'tab');
+  localStorage.setItem('openwa_api_key', 'remembered');
+  assert.equal(getStoredApiKey(), 'tab');
+});
+
+test('logout clears both storage locations', () => {
+  sessionStorage.setItem('openwa_api_key', 'tab');
+  localStorage.setItem('openwa_api_key', 'remembered');
+  clearStoredApiKey();
+  assert.equal(getStoredApiKey(), null);
+  assert.equal(localStorage.getItem('openwa_api_key'), null);
+  assert.equal(sessionStorage.getItem('openwa_api_key'), null);
+});
