+/** One credential source for startup, HTTP requests, and WebSocket connections. */
+const API_KEY_STORAGE_KEY = 'openwa_api_key';
+
+/** Prefer the current tab's credential; otherwise restore a remembered login. */
+export function getStoredApiKey(): string | null {
+  return (
+    sessionStorage.getItem(API_KEY_STORAGE_KEY) ??
+    localStorage.getItem(API_KEY_STORAGE_KEY)
+  );
+}
+
+/** Only persist a credential across browser sessions when explicitly requested. */
+export function saveApiKey(apiKey: string, rememberMe: boolean): void {
+  if (rememberMe) {
+    localStorage.setItem(API_KEY_STORAGE_KEY, apiKey);
+    sessionStorage.removeItem(API_KEY_STORAGE_KEY);
+  } else {
+    sessionStorage.setItem(API_KEY_STORAGE_KEY, apiKey);
+    localStorage.removeItem(API_KEY_STORAGE_KEY);
+  }
+}
+
+/** Logout and revoked credentials must never leave a persistent copy behind. */
+export function clearStoredApiKey(): void {
+  sessionStorage.removeItem(API_KEY_STORAGE_KEY);
+  localStorage.removeItem(API_KEY_STORAGE_KEY);
+}
