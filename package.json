{
  "name": "al-hakim-monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "Al-Hakim Backend and Frontend",
  "scripts": {
    "setup": "npm --prefix backend ci --include=dev && npm --prefix frontend ci --include=dev",
    "postinstall": "npm run setup",
    "dev": "node dev.mjs",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "docker:up": "docker compose up -d --build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": "^22.22.3"
  }
}
